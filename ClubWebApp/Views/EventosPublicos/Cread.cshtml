@model ClubWebApp.Application.Dominio.DTOS.POSTEventosPublicosDto

@{
    ViewData["Title"] = "REGISTRAR EVENTO PUBLICO";
}

<div>
    @* <div class="card-header"></div> *@
    <br />
    <div class="row mt-5 justify-content-center" style="margin-top:-55px !important;">
        <div class="col-sm-7">
            <div class="card-body container-body">
                <div class="card-header text-center">
                    <h3 class="text-capitalize">REGISTRAR EVENTO PUBLICO</h3>
                </div>
                <div>                 
                    <div>
                        <div class="card" style="padding:10px 0">
                            
                            <form asp-action="Cread" asp-controller="EventosPublicos" method="post", id="formEventoPublico">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Nombre" class="form-control" placeholder="Nombre o Titulo del Evento" required />
                                            <span asp-validation-for="Nombre" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Descripcion" class="form-control" placeholder="Descripción del Evento" required />
                                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-10">
                                        <div class="form-gruop form-caja">
                                            <input asp-for="Atracciones" class="form-control" placeholder="Atracciones (Opcional)" required />
                                            <span asp-validation-for="Atracciones" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Tipo" class="form-control" placeholder="Tipo de Evento" required />
                                            <span asp-validation-for="Tipo" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Lugar" class="form-control" placeholder="Lugar o Establecimiento" required />
                                            <span asp-validation-for="Lugar"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Direccion" class="form-control" placeholder="Dirección donde se efectuara el Evento" required />
                                            <span asp-validation-for="Direccion" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-7">
                                        <div class="form-group form-caja">
                                            <input asp-for="Fecha" class="form-control" placeholder="Fecha del Evento" required />
                                            <span asp-validation-for="Fecha" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="HoraInicio" class="form-control" placeholder="Hora de Inicio" required />
                                            <span asp-validation-for="HoraInicio" class="text-danger"></span>
                                        </div>
                                    </div>                                   
                                </div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="HoraFinalizacion" class="form-control" placeholder="Hora de Finalización" required />
                                            <span asp-validation-for="HoraFinalizacion" class="text-danger"></span>
                                        </div>
                                    </div> <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Name_Cliente" class="form-control" placeholder="Nombre Completo del Cliente o Empresa" required />
                                            <span asp-validation-for="Name_Cliente" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Telefono" class="form-control" placeholder="Tel: (809)" required />
                                            <span asp-validation-for="Telefono" class="text-danger"></span>
                                        </div>
                                    </div> <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Email" class="form-control" placeholder="Correo Electrónico (evento@gmail)" required />
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="card-footer">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fa fa-save"> </i> Guardar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal" id="cancelar_formulario">
                                            <i class="fa fa-ban"></i> Cancelar
                                        </button>
                                        <br />
                                        <hr />
                                        <a class="boton-enlace" href="@Url.Action("Index", "Eventos")">VER EVENTO DISTPONIBLE</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-5" style="right:-120px !important;">
            <div class="card-body container-body">
                <div class="card">
                    <div class="card-header">
                        <p class="card-text text-center">Todos nuestos eventos promocionales</p>
                    </div>
                    <div id="carouselExampleCaptions" class="carousel slide card-carousel" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/images/cine-1.webp" class="d-block w-100" alt="Cine">
                                <div class="carousel-caption d-none d-md-block">
                                    <h5>Cine cultural</h5>
                                    <p>Comprende cómo se construye el significado de una sociedad en contextos históricos, políticos, económicos, religiosos y sociales.</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/event-gastro.jpeg" class="d-block w-100" alt="gastronomia">
                                <div class="carousel-caption d-none d-md-block">
                                    <h5>Semana de Gastronomia</h5>
                                    <p>Se celebró del 11 al 17 de noviembre de 2025.</p>
                                    <p>Participaron más de 90 restaurantes, incluidos los de hoteles </p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="/images/event-juego.png" class="d-block w-100" alt="...">
                                <div class="carousel-caption d-none d-md-block">
                                    <h5>Juegos Culturales</h5>
                                    <p>Concursos de pintura y fotografía. Festivales de música y danza folklórica</p>
                                    <p>Representaciones teatrales y obras de danza contemporánea</p>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                    <div class="card-footer">
                        <p class="card-text">No te lo puedes perder.</p>
                        <p class="card-text"></p>
                    </div>
                </div>
                <br />
            </div>
        </div>
        <!--Modal-->
        <div id="confirmModal" class="modal">
            <div class="modal-content">
                <span class="close-button">&times;</span>
                <div class="modal-header">
                    <h2>Confirmar Datos del Eventos</h2>
                </div>
                <div class="modal-body">
                    <p>Por favor, revisa la información antes de confirmar:</p>
                    <p><strong>Nombre/Título:</strong> <span id="modalNombreO_Titulo"></span></p>
                    <p><strong>Cliente ID:</strong> <span id="modalClienteID"></span></p>
                    <p><strong>Lugar:</strong> <span id="modalLugar"></span></p>
                    <p><strong>Atracciones:</strong> <span id="modalAtracciones"></span></p>
                    <p><strong>Descripción:</strong> <span id="modalDescripcion"></span></p>
                    <p><strong>Dirección:</strong> <span id="modalDireccion"></span></p>
                    <p><strong>Fecha y Hora:</strong> <span id="modalFechaHoraEvento"></span></p>
                    <p><strong>Tipo de Evento:</strong> <span id="modalTipoDeEvento"></span></p>
                    <p><strong>Hora de Inicio:</strong> <span id="modalHoraDeInicio"></span></p>
                    <p><strong>Hora de Finalización:</strong> <span id="modalHoraDeFinalizacion"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnConfirmarEnvio" class="btn btn-modal-confirm"><i class="fas fa-check-circle"></i> Confirmar y Enviar</button>
                    <button type="button" id="btnCerrarModal" class="btn btn-modal-cancel"><i class="fas fa-times-circle"></i> Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@*     @Scripts.Render("~/bundles/jqueryval") *@
    <script>
        $(document).ready(function () {
            var modal = $('#confirmModal');
            var btnMostrarModal = $('#btnMostrarModal');
            var btnConfirmarEnvio = $('#btnConfirmarEnvio');
            var btnCerrarModal = $('#btnCerrarModal');
            var spanClose = $('.close-button');
            var form = $('#formEventoPublico');

            btnMostrarModal.on('click', function () {
                // Validar el formulario con jQuery Validation
                if (!form.valid()) {
                    return; // Detener si hay errores de validación
                }

                // Cargar los datos del formulario en el modal
                $('#modalNombreO_Titulo').text($('#NombreO_Titulo').val());
                $('#modalClienteID').text($('#ClienteID').val());
                $('#modalLugar').text($('#Lugar').val());
                $('#modalAtracciones').text($('#Atracciones').val());
                $('#modalDescripcion').text($('#Descripcion').val());
                $('#modalDireccion').text($('#Direccion').val());

                // Formatear la fecha y hora para mostrarla de forma legible
                var fechaHoraInput = $('#FechaHoraEvento').val(); // Formato YYYY-MM-DDTHH:mm
                if (fechaHoraInput) {
                    var dateTime = new Date(fechaHoraInput);
                    var options = { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: true };
                    $('#modalFechaHoraEvento').text(dateTime.toLocaleDateString('es-ES', options));
                } else {
                    $('#modalFechaHoraEvento').text('No especificado');
                }

                $('#modalTipoDeEvento').text($('#TipoDeEvento').val());
                $('#modalHoraDeInicio').text($('#HoraDeInicio').val());
                $('#modalHoraDeFinalizacion').text($('#HoraDeFinalizacion').val());

                modal.css('display', 'flex'); // Mostrar el modal
            });

            btnConfirmarEnvio.on('click', function () {
                // Si el usuario confirma, enviar el formulario
                form.submit();
            });

            btnCerrarModal.on('click', function () {
                modal.css('display', 'none'); // Ocultar el modal
            });

            spanClose.on('click', function () {
                modal.css('display', 'none'); // Ocultar el modal al hacer clic en la 'x'
            });

            // Cerrar el modal si se hace clic fuera del contenido
            $(window).on('click', function (event) {
                if ($(event.target).is(modal)) {
                    modal.css('display', 'none');
                }
            });
        });

        //Cancelar el envio del formulario
        let cancelar_formulario = document.getElementById('cancelar_formulario');
        cancelar_formulario.addEventListener('click', function() {
            location.reload();
        });
    </script>
}

