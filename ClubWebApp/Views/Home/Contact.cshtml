
<div class="row justify-content-center">
    <div class="container" style="margin-top:-10px !important; margin-bottom: -40px !important; display:flex;">
        <div class="col-sm-7">
            <div class="card form-general">
                <div class="contact-header text-center">
                    <div class="card-header">
                        <h4>Contactos</h4>
                    </div>
                </div>
                <article>
                    <h4>¿Tienes alguna pregunta o necesitas más información?</h4>
                    <p>
                        Estamos aquí para ayudarte. Completa el siguiente formulario y nos pondremos en contacto
                        contigo lo antes posible.
                    </p>
                </article>
                <div class="contacto-container"></div>
                <div class="contact-form">
                    <form action="/Home/Contact" id="booking_form" method="post" novalidate="novalidate">
                        <div class="form-row input-group">
                            <div class="form-group col-md-5">
                                <div class="form-gropu form-caja">
                                    <input type="text" name="nombre" placeholder="Tu nombre" required>
                                </div>
                            </div>
                            <div class="form-group col-md-5">
                                <div class="form-gropu form-caja">
                                    <input type="email" name="email" placeholder="Tu correo electrónico" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-row input-group">
                            <div class="form-group col-md-5">
                                <div class="form-group form-caja">
                                    <input type="text" name="telefono" placeholder="Tel.: (809) " />
                                </div>
                            </div>
                            <div class="form-group col-md-5">
                                <div class="form-group form-caja">
                                    <input type="text" name="celular" placeholder="Cel.: (809) " />
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-10">
                                <div class="form-group form-caja">
                                    <input type="text" name="asunto" placeholder="Asunto" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-11">
                                <div class="form-group form-caja ">
                                    <input class="event-input" name="mensaje" size="40" placeholder="Escribe tu mensaje aquí..." required />
                                </div>
                            </div>
                        </div>
                        <div class="form-row input-group captcha">
                            <div class="form-group col-md-4">
                                <label class="control-lable form-caja">
                                    <div id="divGenerateRandomValues"></div>
                                </label>
                            </div>
                            <div class="form-group col-md-4">
                                <div class="form-group form-caja">
                                    <input type="text" id="textInput" class="form-control" placeholder="Enter Captcha" />
                                    <span class="errCap text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-row row">
                            <div class="form-group col-md-5">
                                <div class="boton-contenedor">
                                    <button type="submit" d="btnSubmit" class="boton-enviar">Enviar</button>
                                </div>
                            </div>
                        </div>                    
                    </form>
                </div>
            </div>
        </div>
        <div class="">
            <div class="main-flex">
                <div class="info-section">
                    <article>
                        <h2>Información de Contacto</h2>
                        <div>
                            <h3>Telefono</h3>
                            <p><strong><i class="fas fa-phone"></i></strong> (809) 528-9638 </p>
                            <p><strong><i class="fas fa-phone"></i></strong> (829) 258 9638</p>
                        </div>
                        <div>
                            <h3>Email</h3>
                            <p><strong><i class="fas fa-envelope"></i></strong> event@gmail.com</p>
                            <p><strong><i class="fas fa-envelope"></i></strong> eventclub@gmail.com</p>
                        </div>
                        <div>
                            <h3>Dirección</h3>
                            <p><strong><i class="fas fa-map-marker-alt"></i></strong> Calle Colón 123, Santo Domingo, D.N, Rep. Dom.</p>
                        </div>
                    </article>
                </div>
                <div>
                    <a href="https://www.linkedin.com" target="_blank" class="btn btn-outline-primary btn-social btn-linkedin btn-social-icon footer-icon ">
                        <i class="fab fa-linkedin"></i> @* LinkedIn *@
                    </a>
                    <a href="https://www.twitter.com" target="_blank" class="btn btn-outline-dark btn-social btn-x btn-social-icon footer-icon ">
                        <i class="fab fa-x-twitter"></i> @* X *@
                    </a>
                    <a href="https://www.facebook.com" target="_blank" class="btn btn-outline-primary btn-social btn-social-icon btn-facebook footer-icon ">
                        <i class="fab fa-facebook-f"></i> @* Facebook *@
                    </a>
                    <a href="https://www.instagram.com" target="_blank" class="btn btn-outline-danger btn-social btn-social-icon btn-instagram footer-icon ">
                        <i class="fab fa-instagram"></i> @* Instagram *@
                    </a>
                    <a href="https://wa.me/" target="_blank" class="btn btn-outline-success btn-social-icon btn-social btn-whatsapp footer-icon">
                        <i class="fab fa-whatsapp"></i> @* WhatsApp *@
                    </a>
                    <a href="https://www.threads.net" target="_blank" class="btn btn-outline-dark btn-social-icon btn-social btn-threads footer-icon">
                        <i class="fab fa-threads"></i> @* Threads *@
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/validation_contact.js"></script>

}