@model ClubWebApp.Application.Dominio.DTOS.POSTCreadEventosDto
@{
    ViewData["Title"] = "REGISTRAR EVENTO";
    // Layout = null;
}

<div class="card row">
    <div class="card-header"></div>
    <br />
    <div class="row mt-5 justify-content-center" style="margin-top:-55px !important;">
        <div class="col-sm-7">
            <div class="card-body container-body">
                <div class="card-header text-center">
                    <h5>REGISTRAR EVENTO</h5>
                </div>
                <div>
                    <div>
                        <div class="card">
                            <br />
                            <form asp-action="Cread" asp-controller="Eventos" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="Nombre" class="form-control" placeholder="Titulo" required />
                                            @*  <label>Titulo</label> *@
                                            <span asp-validation-for="Nombre" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="ClienteId" class="form-control" placeholder="ID Cliente" required />
                                            @*   <label>ID Cliente</label> *@
                                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Descripcion" class="form-control" placeholder="Descripción" required />
                                            @*  <label>Descripción</label> *@
                                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Ubicacion" class="form-control" placeholder="Ubicación del Salón" required />
                                            @*  <label style="font-family:18px;">Ubicación del Salón</label> *@
                                            <span asp-validation-for="Ubicacion" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row input-group">
                                    <div class=" form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="Numero_Salon" class="form-control" placeholder="Número del Salón" required />
                                            @*  <label>Número del Salón</label> *@
                                            <span asp-validation-for="Numero_Salon" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="Salon" class="form-control" placeholder="Salón" required />
                                            @*  <label>Salón</label> *@
                                            <span asp-validation-for="Salon" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="Fecha_Evento" class="form-control" placeholder="Fecha del Evento" required data="Fecha_Evento" />
                                            @*  <label>Fecha</label> *@
                                            <span asp-validation-for="Fecha_Evento" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="Cantidad_Personas" class="form-control" placeholder="Cantidad de Personas" required />
                                            @*  <label>Cantidad de Personas</label> *@
                                            <span asp-validation-for="Cantidad_Personas" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-10">
                                        <div class="form-group form-caja">
                                            <input asp-for="Codigo" class="form-control" placeholder="Código" required />
                                            @*  <label>Código</label> *@
                                            <span asp-validation-for="Codigo" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-row input-group">
                                    <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="HoraInicio" class="form-control" placeholder="Hora de Inicio" required />
                                            @*   <label>Hora de Inicio</label> *@
                                            <span asp-validation-for="HoraInicio" class="text-danger"></span>
                                        </div>
                                    </div> <div class="form-group col-md-5">
                                        <div class="form-group form-caja">
                                            <input asp-for="HoraFinalizacion" class="form-control" placeholder="Hora de Finalización" required />
                                            @*  <label>Hora de Finalización</label> *@
                                            <span asp-validation-for="HoraFinalizacion" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <div class="card-footer">
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fa fa-save"> </i> Guardar
                                        </button>
                                        <button type="button" class="btn btn-sm btn-primary" data-bs-dismiss="modal">
                                            <i class="fa fa-ban"></i> Cancelar
                                        </button>
                                        <br />
                                        <hr />
                                        <a class="boton-enlace" href="@Url.Action("Index", "Eventos")">VER EVENTO DISTPONIBLE</a>
                                    </div>
                                </div>                              
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-5" style="right:-120px !important;">
            <div class="card-body container-body">
                <div class="card">
                    <div class="card-header">
                        <p class="card-text text-center">Todos nuestos eventos promocionales</p>
                    </div>
                    <div id="carouselExampleCaptions" class="carousel slide card-carousel" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="~/images/cine-4.webp" class="d-block w-100" alt="Cine">
                                <div class="carousel-caption d-none d-md-block">
                                    <h5>Cine cultural</h5>
                                    <p>Comprende cómo se construye el significado de una sociedad en contextos históricos, políticos, económicos, religiosos y sociales.</p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="~/images/event-gastro.jpeg" class="d-block w-100" alt="gastronomia">
                                <div class="carousel-caption d-none d-md-block">
                                    <h5>Semana de Gastronomia</h5>
                                    <p>Se celebró del 11 al 17 de noviembre de 2025.</p>
                                    <p>Participaron más de 90 restaurantes, incluidos los de hoteles </p>
                                </div>
                            </div>
                            <div class="carousel-item">
                                <img src="/images/event-juego-part-1.jpg" class="d-block w-100" alt="...">
                                <div class="carousel-caption d-none d-md-block">
                                    <h5>Juegos Culturales</h5>
                                    <p>Concursos de pintura y fotografía. Festivales de música y danza folklórica</p>
                                    <p>Representaciones teatrales y obras de danza contemporánea</p>
                                </div>
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                    <div class="card-footer">
                        <p class="card-text">No te lo puedes perder.</p>
                        <p class="card-text"></p>
                    </div>
                </div>
                <br />
            </div>
        </div>
    </div>
</div>



