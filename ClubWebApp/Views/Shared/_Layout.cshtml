<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Event</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!--link event_style.css-->
    <link rel="stylesheet" href="~/css/event_style.css" asp-append-version="true" />
    <!--link Font Awesome-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <!--link menu_style.css-->
    <link rel="stylesheet" href="~/css/menu_style.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="/css/event_reponsive.css" asp-append-version="true" /> *@
    <link rel="stylesheet" href="~/ClubWebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    @*ENLACE PARA EL MENU RESPONSIVE*@
    <link href="~/css/menustyle.css" rel="stylesheet" />
    <!-- AOS CSS -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <!-- Bootstrap CSS + Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

    <!--OPENG GRAPH-->
    <meta property="og:title" content="EVENT - ORGANIZAMOS TU EVENTOS POR TI" />
    <meta property="og:description" content="DINOS QUE DESEA Y NOSOTROS HACEMOS TU EVENTO REALIDA" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="#" />
    <meta property="og:image" content="#" />
    <meta property="og:site_name" content="EVENT" />
</head>
<body>
    <header>
        <nav class="header-navbar navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 ">
            <div class="container-fluid">
                <a class="navbar-brand header-event" asp-area="" asp-controller="Home" asp-action="Index">EVENT</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between topnav" id="myTopnav">
                    <ul class="navbar-nav flex-grow-1">
                       
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Eventos" asp-action="#">PROXIMOS EVENTOS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Eventos" asp-action="Cread">REGISTRAR REVENTO PRIVADO</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="EventosPublicos" asp-action="Index">EVENTO PUBLICO</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Promocionales">EVENTOS PROMOCIONALES</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="EventosPublicos" asp-action="Cread">REGISTRAR EVENTO PUBLICO</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">NUESTRA FILOSOFIA</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">CONTACTOS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Clientes" asp-action="Login">INICIAR SESION</a>
                        </li>                        
                    </ul>
                </div>

            </div>

        </nav>
    </header>

    <!--MENU FLOTANTES-->
    <div class="menu-flotante d-none d-md-flex flex-column align-items-end" id="menuFlotante">
        <div class="menu-opciones">
            <a href="@Url.Action("Index", "Home")" data-aos="zoom-in" data-bs-toggle="tooltip" style="color:aliceblue; font-size:18px;">
                <i class="bi bi-house-door-fill"></i> Event
            </a>
            <a href="@Url.Action("Contact", "Home")" data-aos="zoom-in" data-aos-delay="100" data-bs-toggle="tooltip" style="color:aliceblue; font-size:18px;">
                <i class="bi bi-envelope"></i> Contacto
            </a>
            <a href="@Url.Action("Login", "Clientes")" data-aos="zoom-in" data-aos-delay="200" data-bs-toggle="tooltip" style="color:aliceblue; font-size:18px;">
                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
            </a>
        </div>
        <button class="menu-icono" onclick="toggleMenu()">
            <i class="bi bi-plus-lg" id="iconoMenu"></i>
        </button>
    </div>

    <div class="container">
        @*  <div class="card card-lados" style="width: 17.9rem">
            <div class="card-body">
                <h5 class="card-title">EVENTO PROMOCIONALES</h5>
                <h6 class="card-subtitle mb-2 text-muted">PORQUE UN EVENTO NO TIENE QUE DEJAR DE SER ENTRETENIDO.</h6>
                <p>No te lo puede perder, contara con la participacion de varios artitas del momento.</p>
            </div>
        </div> *@
        @*  <div class="card" style="width: 18rem;">
            <img src="#" alt=""  class="card-img-top"/>
            <div class="card-body">
                <h5 class="card-title">Card title</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                <a href="#" class="btn btn-primary">Go somewhere</a>
            </div>
        </div>
        <div class="card" style="width: 18rem;">
            <img src="..." class="card-img-top" alt="...">
            <div class="card-body">
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
            </div>
        </div> *@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <div class="sub-footer py-4">
        <div class="container">
            <article class="row g-4">
                <div class="col-md-4" data-aos="fade-up">
                    <h5>Planificación Integral</h5>
                    <p>Nos encargamos de cada detalle desde la conceptualización hasta la ejecución del evento.</p>
                </div>
                <div class="col-md-4" data-aos="fade-up">
                    <h5>Descoración Temática</h5>
                    <p>Diseñamos ambientes únicos y personalizados según la ocasión y tus gustos.</p>
                </div>
                <div class="col-md-4" data-aos="fade-up">
                    <h5>Logística y Coordinación</h5>
                    <p>Gestionamos proveedores, tiempos y recursos para garantizar un evento impecable.</p>
                </div>
                <div class="col-md-4" data-aos="fade-up">
                    <h5>Eventos Corporativos</h5>
                    <p>Especialistas en eventos empresariales, lanzamientos de productos y conferencias.</p>
                </div>
                <div class="col-md-4" data-aos="fade-up">
                    <h5>Bodas y Celebraciones</h5>
                    <p>Transformamos tu día especial en una experiencia inolvidable para ti y tus invitados.</p>
                </div>
            </article>
        </div>
    </div>

    <footer class="border-top footer text-muted" style="margin-bottom:-3900px;">
        <style>
            a {
                text-decoration: none;
                margin: 3.3px;
            }

            .foooter-div {
                text-decoration: none;
                font-family: 'Times New Roman', Times, serif;
                font-size: 20px;
                color: aliceblue;
                list-style: none;
                display: inline-flex;
            }

            .footer-p a:hover {
                color: #fff !important;
                font-size: 24px;
                transition: all 0.3s ease-out;
                transform: scale(-3);
            }

        </style>
       @*  <!-- Agregar Font Awesome para los iconos -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"> *@

        <a href="https://www.facebook.com" target="_blank" class="btn btn-outline-primary btn-social btn-facebook footer-icon">
            <i class="fab fa-facebook-f" style="font-size:25px;"></i> @* Facebook *@
        </a>

        <a href="https://www.twitter.com" target="_blank" class="btn btn-outline-dark btn-social btn-x footer-icon">
            <i class="fab fa-x-twitter" style="font-size:25px;"></i> @* X *@
        </a>

        <a href="https://www.instagram.com" target="_blank" class="btn btn-outline-danger btn-social btn-instagram footer-icon ">
            <i class="fab fa-instagram" style="font-size:25px;"></i> @* Instagram *@
        </a>

        <a href="https://www.linkedin.com" target="_blank" class="btn btn-outline-primary btn-social btn-linkedin footer-icon">
            <i class="fab fa-linkedin" style="font-size:25px;"></i> @* LinkedIn *@
        </a>

        <a href="https://www.youtube.com" target="_blank" class="btn btn-outline-danger btn-social btn-youtube footer-icon">
            <i class="fab fa-youtube" style="font-size:25px;"></i> @* YouTube *@
        </a>

        <a href="https://www.tiktok.com" target="_blank" class="btn btn-outline-dark btn-social btn-tiktok footer-icon">
            <i class="fab fa-tiktok" style="font-size:25px;"></i> @* TikTok *@
        </a>

        <a href="https://wa.me/" target="_blank" class="btn btn-outline-success btn-social btn-whatsapp footer-icon">
            <i class="fab fa-whatsapp" style="font-size:25px;"></i> @* WhatsApp *@
        </a>

        <!-- Pinterest -->
        <a href="https://www.pinterest.com" target="_blank" class="btn btn-outline-danger btn-social btn-pinterest footer-icon">
            <i class="fab fa-pinterest" style="font-size:25px;"></i> @* Pinterest *@
        </a>

        <a href="https://discord.com" target="_blank" class="btn btn-outline-primary btn-social btn-discord footer-icon">
            <i class="fab fa-discord" style="font-size:25px;"></i> @* Discord *@
        </a>

        <a href="https://www.reddit.com" target="_blank" class="btn btn-social btn-reddit footer-icon icon-reddit">
            <i class="fab fa-reddit" style="font-size:35px;"></i> @* Reddit *@
        </a>

        <a href="https://www.threads.net" target="_blank" class="btn btn-outline-dark btn-social btn-threads footer-icon">
            <i class="fab fa-threads" style="font-size:25px;"></i> @* Threads *@
        </a>


        <hr />
        <!-- Agregar Font Awesome para los iconos -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

        <div class="container footer-contactos">
            <p class="footer-p">
                &copy; 2025 - EVENT -
                <a asp-area="" asp-controller="Home" asp-action="Contact" class="footer-contact-link">
                    <i class="fas fa-envelope"></i> Contactos
                </a>
            </p>
        </div>
    </footer>

<!--libreria para las vista modal-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Bootstrap y AOS Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    @await RenderSectionAsync("Scripts", required: false)


    <script>
        function toggleMenu() {
          const menu = document.getElementById("menuFlotante");
          const icono = document.getElementById("iconoMenu");
          menu.classList.toggle("open");

          icono.classList.toggle("bi-plus-lg");
          icono.classList.toggle("bi-x-lg");
        }

        document.addEventListener("DOMContentLoaded", function () {
          AOS.init({ duration: 800, once: true });
          const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
          tooltipTriggerList.forEach(el => new bootstrap.Tooltip(el));
        });
    </script>

    <script>
        function myFunction() {
            var x = document.getElementById("myTopnav");
            if (x.className === "topnav") {
                x.className += " responsive";
            } else {
                x.className = "topnav";
            }
        }
    </script>

    <script>
        AOS.init({
          duration: 1000,
          once: true
        });
    </script>
</body>
</html>
